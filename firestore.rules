rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user has admin role
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Enquiries & CRM Leads
    match /enquiries/{enquiryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Projects Collection
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Daily Work Reports & Attendance
    match /daily_reports/{reportId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.resource.data.memberId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /attendance/{attId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Finance, Invoices & Quotations
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
